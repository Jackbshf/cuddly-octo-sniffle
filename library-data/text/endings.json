    {
      "id": "e001",
      "type": "金句收尾",
      "text": "它没教你怎么赢，只教你怎么不输。",
      "topic": "通用"
    },
    {
      "id": "e002",
      "type": "行动号召",
      "text": "下次想硬碰硬之前，先想起这一句。",
      "topic": "通用"
    },
    {
      "id": "e003",
      "type": "留白反问",
      "text": "如果这条路走不通，你敢不敢绕一圈？",
      "topic": "通用"
    },
    {
      "id": "e004",
      "type": "系列预告",
      "text": "下一集讲「无为」到底是不是躺平。",
      "topic": "通用"
    },
    {
      "id": "e005",
      "type": "价值回收",
      "text": "五千字里，这一句我用了十年。",
      "topic": "通用"
    },
    {
      "id": "e006",
      "type": "关注引导",
      "text": "想看完整《道德经》拆解，关注一下，我们一周一集。",
      "topic": "通用"
    }
  ]
