    {
      "id": "h001",
      "type": "悬念反差",
      "text": "有一本书，两千五百年了，第一章就在劝人别说话。",
      "topic": "通用"
    },
    {
      "id": "h002",
      "type": "数据压人",
      "text": "全书五千字，被讨论了二十五个世纪，平均每个字被读了五十万遍。",
      "topic": "通用"
    },
    {
      "id": "h003",
      "type": "反常识",
      "text": "这本书被当成玄学卖了两千年，其实它是一本管理手册。",
      "topic": "通用"
    },
    {
      "id": "h004",
      "type": "身份代入",
      "text": "如果你最近总觉得处处碰壁，这一分半钟可能比看十本书有用。",
      "topic": "通用"
    },
    {
      "id": "h005",
      "type": "痛点点名",
      "text": "越努力越累？这本书给的答案是：别硬来。",
      "topic": "通用"
    },
    {
      "id": "h006",
      "type": "历史背书",
      "text": "孔子五十岁才敢读它，读完说了一句话，被记了两千年。",
      "topic": "通用"
    },
    {
      "id": "h007",
      "type": "提问开场",
      "text": "为什么真正厉害的人，看起来都不着急？",
      "topic": "通用"
    },
    {
      "id": "h008",
      "type": "极端对比",
      "text": "同一个道理，用来说服人的叫鸡汤，用来做事的叫道。",
      "topic": "通用"
    }
  ]
