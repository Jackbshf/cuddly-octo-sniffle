{
  "name": "zhangwei-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build:app": "node scripts/build-app.mjs",
    "sync:portfolio": "node scripts/sync-portfolio-json.mjs",
    "sync:stream": "node scripts/media/sync-cloudflare-stream.mjs",
    "prepare:static": "node scripts/prepare-static.mjs",
    "deploy:worker": "wrangler deploy --config wrangler.jsonc --assets=./dist",
    "deploy:preview": "wrangler deploy --config wrangler.jsonc --assets=./dist --name floral-leaf-4e44-preview",
    "deploy:worker:version": "wrangler versions upload --config wrangler.jsonc --assets=./dist",
    "audit:stream": "node scripts/media/audit-stream-delivery.mjs",
    "generate:prompts": "node scripts/prompts/generate-cinematic-prompts.mjs && node scripts/prompts/generate-visual-prompts.mjs && node scripts/prompts/build-search-index.mjs --write-library",
    "generate:cinematic-prompts": "node scripts/prompts/generate-cinematic-prompts.mjs",
    "generate:visual-prompts": "node scripts/prompts/generate-visual-prompts.mjs",
    "build:prompt-index": "node scripts/prompts/build-search-index.mjs",
    "enhance:prompts": "node scripts/prompts/build-search-index.mjs --write-library",
    "validate:prompts": "node scripts/prompts/build-search-index.mjs --write-library && node scripts/prompts/validate-general-prompts.mjs",
    "prompts:d1:migrate": "wrangler d1 migrations apply zhangwei-prompts --local --persist-to .wrangler/prompt-workbench-state --config wrangler.jsonc",
    "prompts:d1:migrate:remote": "wrangler d1 migrations apply zhangwei-prompts --remote --config wrangler.jsonc",
    "prompts:d1:seed": "node scripts/prompts/seed-d1.mjs --local",
    "prompts:d1:seed:remote": "node scripts/prompts/seed-d1.mjs --remote",
    "prompts:d1:init": "npm run prompts:d1:migrate && npm run prompts:d1:seed",
    "prompts:dev": "wrangler dev --config wrangler.jsonc --assets=./dist --local --persist-to .wrangler/prompt-workbench-state"
  },
  "dependencies": {
    "hls.js": "^1.6.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.34.4",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "esbuild": "0.25.4",
    "playwright": "^1.59.1",
    "tailwindcss": "3.4.17",
    "wrangler": "4.88.0"
  }
}
